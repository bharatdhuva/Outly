# Python ATS / matcher service
APP_NAME=outly-python-ats
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Google Gemini (optional — without a key, scoring still works; llm_analysis is null
# and matcher semantic similarity uses the local TF-IDF fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Timeouts / retries
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=20

# Input limits (must stay aligned with Node multer: 5 MB)
MAX_FILE_BYTES=5242880
MAX_TEXT_CHARS=80000

# Matcher weights (must sum to 1.0)
MATCH_SKILL_WEIGHT=0.55
MATCH_SEMANTIC_WEIGHT=0.30
MATCH_SENIORITY_WEIGHT=0.15

# Optional shared secret if you expose this service beyond the Node proxy
INTERNAL_API_KEY=

# Node origin used only by scripts/compare_with_node.py
NODE_ATS_BASE_URL=http://localhost:3001/api/ats
PYTHON_ATS_BASE_URL=http://localhost:8000/api/ats
NODE_COMPARE_TOKEN=
