{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{backend/dist/**,node_modules/pdf-parse/**,node_modules/mammoth/**,node_modules/dommatrix/**,backend/node_modules/pdf-parse/**,backend/node_modules/mammoth/**,backend/node_modules/dommatrix/**}"
    },
    "api/python_ats.py": {
      "maxDuration": 60,
      "includeFiles": "python-ats/app/**"
    }
  },
  "rewrites": [
    {
      "source": "/python-ats/:path*",
      "destination": "/api/python_ats?originalPath=/python-ats/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?originalPath=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
